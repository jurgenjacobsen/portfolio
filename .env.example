GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_HOSTNAME=example.com

VITE_MAPBOX_ACCESS_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxx

# Supabase (Client anon key safe for browser)
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# Also supported if using Next/Vercel standard naming:
# NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Build-time / server service role key for prerendering and scripts
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Optional: Restrict admin console to specific email(s) (comma-separated)
VITE_ADMIN_EMAIL=your-email@example.com
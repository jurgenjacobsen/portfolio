{
    "redirects": [
        {
            "source": "/projects",
            "destination": "/code",
            "permanent": true
        },
        {
            "source": "/projects/:slug",
            "destination": "/code/:slug",
            "permanent": true
        }
    ],
    "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
